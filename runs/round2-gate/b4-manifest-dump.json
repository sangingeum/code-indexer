  "schema_sql": {
    "chunks": "CREATE TABLE chunks (\n    file TEXT NOT NULL,\n    chunk_index INTEGER NOT NULL,\n    start_line INTEGER NOT NULL,\n    end_line INTEGER NOT NULL,\n    symbol TEXT,\n    symbol_type TEXT,\n    chunk_hash TEXT NOT NULL,\n    text TEXT NOT NULL,\n    PRIMARY KEY (file, chunk_index)\n)",
    "chunks_fts": "CREATE VIRTUAL TABLE chunks_fts USING fts5(content, symbol, path, tokenize='unicode61')",
    "chunks_fts_config": "CREATE TABLE 'chunks_fts_config'(k PRIMARY KEY, v) WITHOUT ROWID",
    "chunks_fts_content": "CREATE TABLE 'chunks_fts_content'(id INTEGER PRIMARY KEY, c0, c1, c2)",
    "chunks_fts_data": "CREATE TABLE 'chunks_fts_data'(id INTEGER PRIMARY KEY, block BLOB)",
    "chunks_fts_docsize": "CREATE TABLE 'chunks_fts_docsize'(id INTEGER PRIMARY KEY, sz BLOB)",
    "chunks_fts_idx": "CREATE TABLE 'chunks_fts_idx'(segid, term, pgno, PRIMARY KEY(segid, term)) WITHOUT ROWID",
    "files": "CREATE TABLE files (\n    path TEXT PRIMARY KEY,\n    content_hash TEXT NOT NULL,\n    size INTEGER NOT NULL,\n    chunk_count INTEGER NOT NULL DEFAULT 0,\n    status TEXT NOT NULL DEFAULT 'ok',\n    mtime_ns INTEGER,\n    inode INTEGER,\n    loc INTEGER,\n    language TEXT,\n    parse_verdict TEXT\n)",
    "idx_refs_to_name": "CREATE INDEX idx_refs_to_name ON refs(to_name)",
    "idx_symbols_container": "CREATE INDEX idx_symbols_container ON symbols(container)",
    "idx_symbols_file_start": "CREATE INDEX idx_symbols_file_start ON symbols(file, start_line)",
    "idx_symbols_id": "CREATE UNIQUE INDEX idx_symbols_id ON symbols(id)",
    "idx_symbols_name": "CREATE INDEX idx_symbols_name ON symbols(name)",
    "idx_symbols_qualified": "CREATE INDEX idx_symbols_qualified ON symbols(qualified_name)",
    "imports": "CREATE TABLE imports (\n    file TEXT NOT NULL,\n    raw_target TEXT NOT NULL,\n    resolved_file TEXT,          -- best-effort project-relative resolution\n    kind TEXT NOT NULL,          -- import|include|require|use|...\n    line INTEGER NOT NULL,\n    PRIMARY KEY (file, raw_target, line)\n)",
    "index_errors": "CREATE TABLE index_errors (\n    file TEXT NOT NULL,\n    chunk_index INTEGER,\n    error TEXT NOT NULL,\n    at REAL NOT NULL,\n    PRIMARY KEY (file, chunk_index)\n)",
    "meta": "CREATE TABLE meta (\n    key TEXT PRIMARY KEY,\n    value TEXT\n)",
    "refs": "CREATE TABLE refs (\n    file TEXT NOT NULL,\n    line INTEGER NOT NULL,\n    from_symbol TEXT,            -- NULL when the reference is module-level\n    to_name TEXT NOT NULL,\n    relationship TEXT NOT NULL,  -- call|type|base_class|member|includes|identifier\n    confidence TEXT NOT NULL,    -- ast | heuristic\n    receiver TEXT,               -- member-access receiver as written, else NULL\n    target_symbol_id INTEGER,    -- v7: resolved target, NULL until populated\n    resolution TEXT,             -- v7: none|same_file|same_project|backend\n    PRIMARY KEY (file, line, to_name, relationship)\n)",
    "sqlite_autoindex_chunks_1": null,
